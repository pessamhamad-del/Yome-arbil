<!DOCTYPE html>
<html lang="ckb" dir="rtl" id="htmlTag">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>YOME Erbil | Family Mall</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@400;600;700&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap');
    body {
      font-family: 'Noto Sans Arabic', 'Plus Jakarta Sans', sans-serif;
      transition: background 0.4s ease, color 0.4s ease;
    }
    /* Theme Styles */
    body.theme-dark { background-color: #0b0f19; color: #f8fafc; }
    body.theme-white { background-color: #ffffff; color: #0f172a; }
    body.theme-white .card-box { background-color: #f1f5f9; border-color: #cbd5e1; }
    body.theme-sky { background-color: #e0f2fe; color: #0369a1; }
    body.theme-sky .card-box { background-color: #ffffff; border-color: #bae6fd; }
    body.theme-coffee { background: linear-gradient(135deg, #fdfbf7 0%, #ebd5b3 50%, #4a2c11 100%); color: #271608; }
    body.theme-coffee .card-box { background-color: rgba(255,255,255,0.85); border-color: #d7b98e; }
    body.theme-animated {
      background: linear-gradient(-45deg, #ff007f, #7928ca, #0070f3, #00dfd8);
      background-size: 400% 400%;
      animation: gradientBG 10s ease infinite;
      color: #ffffff;
    }
    body.theme-animated .card-box { background-color: rgba(0, 0, 0, 0.45); backdrop-filter: blur(10px); border-color: rgba(255,255,255,0.2); }
    @keyframes gradientBG {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }
  </style>
</head>
<body class="theme-dark min-h-screen">

  <!-- Setup Bar: Language & Theme Selectors -->
  <div class="border-b border-slate-700/40 p-4 sticky top-0 z-40 backdrop-blur-md bg-black/30">
    <div class="max-w-md mx-auto flex flex-col gap-3">
      <!-- Language Selection -->
      <div class="flex items-center justify-between">
        <label class="text-xs font-semibold" id="lbl-lang">زمان هەڵبژێرە:</label>
        <select id="langSelect" onchange="changeLang(this.value)" class="text-xs bg-slate-800 text-white border border-slate-600 rounded-lg px-2.5 py-1.5 outline-none">
          <option value="ku" selected>کوردی (Central)</option>
          <option value="ar">عربي</option>
          <option value="en">English</option>
          <option value="zh">中文</option>
        </select>
      </div>

      <!-- Style Selection -->
      <div class="flex items-center justify-between">
        <label class="text-xs font-semibold" id="lbl-style">ستایلێک دیاری بکە:</label>
        <select id="themeSelect" onchange="changeTheme(this.value)" class="text-xs bg-slate-800 text-white border border-slate-600 rounded-lg px-2.5 py-1.5 outline-none">
          <option value="theme-dark" id="opt-dark">ڕەنگی ڕەشی تۆخ</option>
          <option value="theme-white" id="opt-white">ڕەنگی سپی</option>
          <option value="theme-sky" id="opt-sky">ڕەنگی شینی ئاسمانی</option>
          <option value="theme-coffee" id="opt-coffee">سپی و قاوەیی تێکەڵ</option>
          <option value="theme-animated" id="opt-anim">ڕووناک و جووڵاو</option>
        </select>
      </div>
    </div>
  </div>

  <!-- Header & Logo Section -->
  <header class="text-center pt-8 pb-4 px-4 max-w-md mx-auto">
    <!-- YOME Logo SVG recreation matching original brand -->
    <div class="flex justify-center mb-3">
      <svg class="w-36 h-auto drop-shadow-md" viewBox="0 0 260 90" fill="none" xmlns="http://www.w3.org/2000/svg">
        <text x="10" y="70" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-weight="900" font-size="75" fill="#E11D48" letter-spacing="-3">Yome</text>
      </svg>
    </div>
    <h2 id="txt-slogan" class="text-sm font-semibold tracking-wide text-rose-500 mb-4">Best choice to shopping</h2>

    <!-- Account Button -->
    <button onclick="toggleModal(true)" id="btn-create-acc" class="w-full bg-rose-600 hover:bg-rose-500 text-white py-3 rounded-2xl text-xs font-bold shadow-lg shadow-rose-600/30 transition flex items-center justify-center gap-2">
      <i class="fa-solid fa-user-plus"></i>
      <span id="btn-create-acc-text">هەژمار دروست بکە</span>
    </button>
  </header>

  <!-- Quick Info & Location -->
  <section class="max-w-md mx-auto px-4 py-2 space-y-3">
    <!-- Opening Hours -->
    <div class="card-box bg-slate-900/60 border border-slate-800 p-3 rounded-2xl flex items-center gap-3 text-xs">
      <i class="fa-regular fa-clock text-rose-500 text-base"></i>
      <span id="txt-hours">Open 9:00Am until 11:00Pm (All day)</span>
    </div>

    <!-- Location -->
    <a href="https://maps.google.com/?q=Family+Mall+Erbil" target="_blank" class="card-box bg-slate-900/60 border border-slate-800 p-3 rounded-2xl flex items-center justify-between text-xs hover:border-rose-500 transition">
      <div class="flex items-center gap-3">
        <i class="fa-solid fa-location-dot text-rose-500 text-base"></i>
        <div>
          <p class="font-bold" id="lbl-location">شوێن / شوێنمان بدۆزەوە</p>
          <p class="text-slate-400 text-[11px]">Family Mall Irbil, Iraq</p>
        </div>
      </div>
      <i class="fa-solid fa-arrow-up-right-from-square text-slate-400"></i>
    </a>

    <!-- Instagram Official Link -->
    <a href="https://www.instagram.com/yome_erbil?stkn=MWJsODhpMDBmNXB3MQ==" target="_blank" class="card-box bg-slate-900/60 border border-slate-800 p-3 rounded-2xl flex items-center justify-between text-xs hover:border-rose-500 transition">
      <div class="flex items-center gap-3">
        <i class="fa-brands fa-instagram text-rose-500 text-lg"></i>
        <div>
          <p class="font-bold">Instagram</p>
          <p class="text-slate-400 text-[11px]">@yome_erbil</p>
        </div>
      </div>
      <span class="text-[10px] bg-rose-500/20 text-rose-400 px-2 py-0.5 rounded font-semibold">فەرمی</span>
    </a>
  </section>

  <!-- Products Showcase -->
  <section class="max-w-md mx-auto px-4 py-6">
    <h3 id="txt-products-title" class="text-sm font-bold mb-4">بەرهەمە دیارەکان</h3>
    <div class="grid grid-cols-2 gap-3">
      
      <!-- Product 1 -->
      <div class="card-box bg-slate-900/60 border border-slate-800 rounded-2xl p-2.5 flex flex-col justify-between" onclick="showModalImage('https://images.unsplash.com/photo-1596755094514-f87e34085b2c?w=700')">
        <img src="https://images.unsplash.com/photo-1596755094514-f87e34085b2c?w=500" class="w-full h-36 object-cover rounded-xl mb-2" alt="Product">
        <div>
          <h4 class="text-xs font-bold leading-tight" id="p1-title">جلوبەرگی تایبەت</h4>
          <p class="text-[10px] text-slate-400 mt-0.5" id="p1-desc">کوالێتی بەرز و نەرم</p>
          <p class="text-xs font-bold text-rose-500 mt-2">12,000 IQD</p>
        </div>
      </div>

      <!-- Product 2 -->
      <div class="card-box bg-slate-900/60 border border-slate-800 rounded-2xl p-2.5 flex flex-col justify-between" onclick="showModalImage('https://images.unsplash.com/photo-1533090161767-e6ffed986c88?w=700')">
        <img src="https://images.unsplash.com/photo-1533090161767-e6ffed986c88?w=500" class="w-full h-36 object-cover rounded-xl mb-2" alt="Product">
        <div>
          <h4 class="text-xs font-bold leading-tight" id="p2-title">مێزی تاشراو و مۆدێرن</h4>
          <p class="text-[10px] text-slate-400 mt-0.5" id="p2-desc">گونجاو بۆ خوێندن و کار</p>
          <p class="text-xs font-bold text-rose-500 mt-2">18,000 IQD</p>
        </div>
      </div>

      <!-- Product 3 -->
      <div class="card-box bg-slate-900/60 border border-slate-800 rounded-2xl p-2.5 flex flex-col justify-between" onclick="showModalImage('https://images.unsplash.com/photo-1608256246200-53e635b5b65f?w=700')">
        <img src="https://images.unsplash.com/photo-1608256246200-53e635b5b65f?w=500" class="w-full h-36 object-cover rounded-xl mb-2" alt="Product">
        <div>
          <h4 class="text-xs font-bold leading-tight" id="p3-title">نەعلی ماڵەوەی پریمێم</h4>
          <p class="text-[10px] text-slate-400 mt-0.5" id="p3-desc">سووک و تەندروست</p>
          <p class="text-xs font-bold text-rose-500 mt-2">12,000 IQD</p>
        </div>
      </div>

      <!-- Product 4 -->
      <div class="card-box bg-slate-900/60 border border-slate-800 rounded-2xl p-2.5 flex flex-col justify-between" onclick="showModalImage('https://images.unsplash.com/photo-1560769629-975ec94e6a86?w=700')">
        <img src="https://images.unsplash.com/photo-1560769629-975ec94e6a86?w=500" class="w-full h-36 object-cover rounded-xl mb-2" alt="Product">
        <div>
          <h4 class="text-xs font-bold leading-tight" id="p4-title">نەعلی دیزاینی ورچ</h4>
          <p class="text-[10px] text-slate-400 mt-0.5" id="p4-desc">ئیسراحەت و جوان</p>
          <p class="text-xs font-bold text-rose-500 mt-2">18,000 IQD</p>
        </div>
      </div>

    </div>
  </section>

  <!-- Quote & Trust Section -->
  <footer class="max-w-md mx-auto px-6 py-10 text-center border-t border-slate-800/40">
    <p id="txt-trust-quote" class="text-xs font-semibold leading-relaxed text-rose-400">
      متمانە لەپێش پارەوەیە ، ئێمە هەڵبژێرن و کوالێتی بەرز ببینن …
    </p>
    <p class="text-[10px] text-slate-500 mt-4">© 2026 YOME. All rights reserved.</p>
  </footer>

  <!-- Sign Up Modal (Google, Apple ID, Phone Number) -->
  <div id="authModal" class="fixed inset-0 bg-black/75 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="card-box bg-slate-900 border border-slate-800 rounded-3xl p-6 w-full max-w-xs text-center relative shadow-2xl">
      <button onclick="toggleModal(false)" class="absolute top-4 left-4 text-slate-400 text-lg hover:text-white">&times;</button>
      <h3 id="modal-title" class="text-base font-bold mb-1">دروستکردنی هەژمار</h3>
      <p id="modal-sub" class="text-[11px] text-slate-400 mb-5">بەردەوام بە بە یەک کلیک</p>

      <button class="w-full bg-white text-slate-900 text-xs font-semibold py-2.5 px-3 rounded-xl flex items-center justify-center gap-2 mb-2">
        <i class="fa-brands fa-google text-rose-500"></i> Google
      </button>

      <button class="w-full bg-slate-800 border border-slate-700 text-white text-xs font-semibold py-2.5 px-3 rounded-xl flex items-center justify-center gap-2 mb-3">
        <i class="fa-brands fa-apple text-white text-sm"></i> Apple ID
      </button>

      <div class="flex items-center my-3">
        <div class="flex-grow border-t border-slate-700"></div>
        <span class="px-2 text-[10px] text-slate-400" id="modal-or">یان</span>
        <div class="flex-grow border-t border-slate-700"></div>
      </div>

      <input type="tel" id="input-phone" placeholder="0750 000 0000" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-xs text-center mb-3 outline-none text-white">
      <button class="w-full bg-rose-600 text-white text-xs font-bold py-2.5 rounded-xl shadow-lg shadow-rose-600/20" id="btn-submit-phone">تەواوکردن</button>
    </div>
  </div>

  <!-- Image Lightbox Modal -->
  <div id="imgModal" onclick="this.classList.add('hidden')" class="fixed inset-0 bg-black/90 z-50 hidden flex items-center justify-center p-4 cursor-pointer">
    <img id="previewImg" src="" class="max-w-full max-h-[85vh] rounded-2xl shadow-2xl object-contain">
  </div>

  <!-- Multi-Language Data & System Script -->
  <script>
    const translations = {
      ku: {
        dir: 'rtl',
        lblLang: 'زمان هەڵبژێرە:',
        lblStyle: 'ستایلێک دیاری بکە:',
