      }
    };

    function changeLang(lang) {
      const data = translations[lang];
      document.getElementById('htmlTag').setAttribute('dir', data.dir);
      document.getElementById('lbl-lang').innerText = data.lblLang;
      document.getElementById('lbl-style').innerText = data.lblStyle;
      document.getElementById('opt-dark').innerText = data.optDark;
      document.getElementById('opt-white').innerText = data.optWhite;
      document.getElementById('opt-sky').innerText = data.optSky;
      document.getElementById('opt-coffee').innerText = data.optCoffee;
      document.getElementById('opt-anim').innerText = data.optAnim;
      document.getElementById('txt-slogan').innerText = data.slogan;
      document.getElementById('btn-create-acc-text').innerText = data.btnAcc;
      document.getElementById('txt-hours').innerText = data.hours;
      document.getElementById('lbl-location').innerText = data.locTitle;
      document.getElementById('txt-products-title').innerText = data.prodTitle;
      document.getElementById('txt-trust-quote').innerText = data.quote;
      document.getElementById('modal-title').innerText = data.modalTitle;
      document.getElementById('modal-sub').innerText = data.modalSub;
      document.getElementById('modal-or').innerText = data.modalOr;
      document.getElementById('btn-submit-phone').innerText = data.submit;

      // Products translation
      document.getElementById('p1-title').innerText = data.p1[0];
      document.getElementById('p1-desc').innerText = data.p1[1];
      document.getElementById('p2-title').innerText = data.p2[0];
      document.getElementById('p2-desc').innerText = data.p2[1];
      document.getElementById('p3-title').innerText = data.p3[0];
      document.getElementById('p3-desc').innerText = data.p3[1];
      document.getElementById('p4-title').innerText = data.p4[0];
      document.getElementById('p4-desc').innerText = data.p4[1];
    }

    function changeTheme(themeClass) {
      document.body.className = themeClass + ' min-h-screen';
    }

    function toggleModal(show) {
      document.getElementById('authModal').classList.toggle('hidden', !show);
    }

    function showModalImage(src) {
      document.getElementById('previewImg').src = src;
      document.getElementById('imgModal').classList.remove('hidden');
    }
  </script>
</body>
</html>
